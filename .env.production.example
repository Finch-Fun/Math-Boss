# Copy to .env.production.local (never commit it) and paste the values from
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# These identify your project to the browser; they are not secrets, but they are kept out of git so the repo stays project-neutral.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Must equal the region the Functions are deployed to. The deploy script copies this value to the Functions, so they always match.
VITE_FUNCTIONS_REGION=us-central1
VITE_USE_FIREBASE_EMULATOR=false
