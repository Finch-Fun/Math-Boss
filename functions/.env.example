# You normally do NOT create this by hand: `npm run deploy:live` generates functions/.env.<project-id> from your
# .env.production.local (region and Hosting origins), so the Functions always match the frontend.
# Shown here for reference only.
MATHBOSS_FUNCTIONS_REGION=us-central1
MATHBOSS_ALLOWED_ORIGINS=https://<project-id>.web.app,https://<project-id>.firebaseapp.com
# NEVER set MATHBOSS_ENABLE_TEST_CLOCK in production (the deploy script refuses to deploy if it is set).
