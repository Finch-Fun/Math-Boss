# Copy to .env.local (never commit it). Values come from Firebase console > Project settings > Your apps > Web app.
# This must be a NEW Firebase project dedicated to Math Boss, separate from any other project.
# Leave everything blank to run the app in local demo mode (no Firebase).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Region of the deployed Cloud Functions. Must equal MATHBOSS_FUNCTIONS_REGION used at deploy time (default us-central1).
VITE_FUNCTIONS_REGION=us-central1

# Local development against the Firebase emulators (no real project needed). Set to true to enable.
# Start the emulators with: npm run emulators
VITE_USE_FIREBASE_EMULATOR=
